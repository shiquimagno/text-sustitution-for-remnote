    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "autoprefixer": "^10.4.7",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss": "^8.4.14",
    "postcss-import": "^14.1.0",
    "postcss-loader": "^7.0.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.1.5",
    "typescript": "^5.9.0",
    "webpack": "^5.73.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "tsx": "^4.20.0"
